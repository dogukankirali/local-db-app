# docker compose için örnek ayarlar. Kopyala: cp .env.example .env
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=localdb
DB_PORT_HOST=5432

JWT_SECRET_KEY=change-me
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

