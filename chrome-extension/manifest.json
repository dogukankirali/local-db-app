{
  "manifest_version": 3,
  "name": "Anime Watchlist",
  "version": "1.0",
  "description": "Track your anime watching progress and add animes from MyAnimeList",
  "icons": {
    "48": "icons/kakashi.ico",
    "96": "icons/kakashi.ico"
  },
  "permissions": ["activeTab", "storage", "webRequest", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "https://localhost:8080/*",
    "https://myanimelist.net/*",
    "https://anizium.com/*",
    "https://turkanime.co/*",
    "https://www.turkanime.co/*",
    "https://www.tranimeizle.top/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/kakashi.ico",
      "96": "icons/kakashi.ico"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://myanimelist.net/anime/*",
        "https://anizium.com/*",
        "https://turkanime.co/*",
        "https://www.turkanime.co/*",
        "https://www.tranimeizle.top/*",
        "https://tranimeizle.top/*"
      ],
      "js": ["content/content.js"]
    }
  ]
}
