{
  "name": "kiroku-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../frontend run build:cf && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply kiroku --local",
    "db:migrate:remote": "wrangler d1 migrations apply kiroku --remote",
    "db:import": "node scripts/pg-dump-to-d1.mjs",
    "set-password": "node scripts/set-password.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
