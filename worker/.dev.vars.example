# cp .dev.vars.example .dev.vars  (wrangler dev bu dosyayı okur, git'e girmez)
JWT_SECRET_KEY=dev-only-change-me
ENVIRONMENT=development
# Şifre sıfırlama bağlantısı next dev (:3000) adresine gitsin
APP_URL=http://localhost:3000
# Mail göndermek istersen: https://resend.com → API Keys
# RESEND_API_KEY=re_...

# Dizi/film ayrıntıları (IMDb verisi): https://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=

# Kitap ayrıntıları (Google Books, ücretsiz anahtar): https://console.cloud.google.com/apis/library/books.googleapis.com
# GOOGLE_BOOKS_API_KEY=

# Tarayıcı bildirimleri: VAPID özel anahtarı (wrangler.jsonc'deki VAPID_PUBLIC_KEY ile eş). Yeni çift üretmek için README → Yeni bölüm bildirimleri
# VAPID_PRIVATE_KEY=

# Google ile giriş (README → Google ile giriş)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
