# Lokal geliştirme: ENV=development iken backend sertifikasız HTTP ile çalışır
# (HTTPS gerekirse DEV_TLS=true ve backend/server.crt + server.key)
ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=localdb
JWT_SECRET_KEY=change-me
APP_URL=http://localhost:3000

# Şifre sıfırlama e-postası (prod'da zorunlu; dev'de boşsa bağlantı backend loguna yazılır)
# 587 = STARTTLS, 465 = doğrudan TLS. Örn. Gmail: smtp.gmail.com / 587 + uygulama şifresi
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Kiroku <no-reply@example.com>
