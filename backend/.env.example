# Lokal geliştirme: ENV=development iken backend sertifikasız HTTP ile çalışır
# (HTTPS gerekirse DEV_TLS=true ve backend/server.crt + server.key)
ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=localdb
JWT_SECRET_KEY=change-me
APP_URL=http://localhost:3000
